# Copy to .env (scripts/setup.sh does this automatically). NEVER commit .env.

# --- Shared -----------------------------------------------------------------
# true: the API returns canned JSON without real EDC connectors (default)
MOCK_MODE=true
# Base URL of the FastAPI gateway (S4)
API_URL=http://localhost:8000

# --- Federated learning (S2) ------------------------------------------------
# Flower server address, as seen from the client / server respectively
SERVER_ADDRESS=localhost:8080
NUM_ROUNDS=5
# Client only: hospital identity and its local CSV (mounted at /data/data.csv
# in Docker)
HOSPITAL_ID=a
DATA_PATH=data/hospitals/a.csv
